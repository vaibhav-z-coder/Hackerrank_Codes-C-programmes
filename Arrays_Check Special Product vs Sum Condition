#include<stdio.h>
int main(){
    int n;
    scanf("%d", &n);
    int a[n];
    for(int i=0;i<n;i++){
        scanf("%d", &a[i]);
        
    }
    //////////////////////////////////////////////////
     int small=a[0];
    int larg=a[0];
    int ssmall=1000000000;
    int slarg=-1000000000;
    //////////////////////////////////////////////////
        for(int i=0;i<n;i++){
        if(a[i]<small){
            small=a[i];
        }
        if(a[i]>larg){
            larg=a[i];
        }
        
        for(int i=0;i<n;i++){
              if(a[i]!=small && ssmall>a[i]){
            ssmall=a[i];
        }
          if(a[i]!=larg && a[i]>slarg){
            slarg=a[i];
        }
        }
        
    }
    if((slarg*small)>(ssmall+larg)){
        printf("True");
    }
    else{
        printf("False");
    }
        
        
    
    
}
